{
  "userAgent": "job_seeker_ro_spider",
  "requestTimeoutSec": 10,
  "pageDelaySec": 1.0,
  "retry": {
    "maxAttempts": 5,
    "baseDelaySec": 2.0,
    "maxDelaySec": 60.0,
    "retryStatus": [429, 500, 502, 503, 504]
  },
  "staleJobDeletion": false,
  "manageCompany": false,
  "defaultLocation": ["Iași"],
  "defaultWorkmode": "on-site",
  "ownJobUrlPrefix": "https://www.antibiotice.ro/joburi/",
  "sources": {
    "sitemap": "https://www.antibiotice.ro/joburi-sitemap.xml",
    "listing": "https://www.antibiotice.ro/cariere/open-position/",
    "jobArchive": "https://www.antibiotice.ro/joburi/"
  },
  "selectors": {
    "jobArticle": ["article.job-item", "[class*='job']", ".vacancy, .position, .listing-item"],
    "jobTitle": [".header-job h3", "h1, h2, h3, h4", "[itemprop='title'], [aria-label]", "a"],
    "jobMeta": ["article.job-item > p", "p, .meta, [class*='deadline']"]
  }
}
